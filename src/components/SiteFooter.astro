---
import { profile, socials } from '../data/portfolio';
import { siGithub, siX, siInstagram, siSubstack } from 'simple-icons';
import AsciiMotif from './AsciiMotif.astro';

const icons: Record<string, string> = {
  GitHub: siGithub.path,
  LinkedIn: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.978 0 1.778-.773 1.778-1.729V1.729C24 .774 23.203 0 22.225 0z',
  'Twitter / X': siX.path,
  Instagram: siInstagram.path,
  Substack: siSubstack.path,
};
const socialLinks = socials.filter((social) => social.label in icons);
---
<footer class="page-width site-footer">
  <AsciiMotif variant="waves" class="footer-ascii" />
  <nav aria-label="Contact and social links" class="footer-socials">
    <a class="footer-email" href={`mailto:${profile.email}`}>{profile.email}</a>
    {socialLinks.map((social) => (
      <a class="footer-social-link" href={social.href} aria-label={social.label} title={social.label} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
          <path d={icons[social.label]} />
        </svg>
      </a>
    ))}
  </nav>
</footer>
