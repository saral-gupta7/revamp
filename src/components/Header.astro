---
import { profile } from '../data/portfolio';
import AsciiMotif from './AsciiMotif.astro';
const currentPath = Astro.url.pathname;
const navItems = [
  { number: '01', label: 'Work', href: '/work/' },
  { number: '02', label: 'Writing', href: '/blog/' },
  { number: '03', label: 'About', href: '/about/' },
  { number: '04', label: 'Setup', href: '/setup/' },
  { number: '05', label: 'Contact', href: '/connect/' },
];
---
<aside class="site-header" aria-label="Site navigation">
  <nav aria-label="Primary navigation" class="primary-nav">
    <a class="nav-home" href="/" aria-label={profile.name + ', home'}>SG<span aria-hidden="true">.</span></a>
    <span class="nav-caption">Explore</span>
    {navItems.map((item) => (
      <a class="nav-route" href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
        <span class="nav-number" aria-hidden="true">{item.number}</span>
        <span>{item.label}</span>
        <span class="nav-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
  <AsciiMotif variant="pine" class="nav-ascii" />
</aside>
