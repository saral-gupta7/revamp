---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { profile } from '../../data/portfolio';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const title = `Writing | ${profile.name}`;
const description = 'Notes from Saral Gupta on software engineering, systems, Linux, cybersecurity, and learning.';
const formatDate = new Intl.DateTimeFormat('en', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});
---

<BaseLayout {title} {description}>
	<div id="top">
		<Header />
		<main id="main-content" class="site-shell">
			<header class="blog-page-header">
				<div class="flex items-center justify-between gap-4">
					<p class="section-kicker">Blog / 記録</p>
					<span class="font-mono text-[0.65rem] text-muted">{String(posts.length).padStart(2, '0')} entries</span>
				</div>
				<h1 class="mt-5 text-[clamp(2.5rem,5vw,4.5rem)] font-semibold leading-none tracking-[-0.055em]">Field notes.</h1>
				<p class="mt-5 max-w-xl text-base leading-7 text-muted">Things I learned while building systems, breaking Linux installations, and following technical rabbit holes.</p>
			</header>

			<section class="px-5 py-8 sm:px-8 sm:py-10" aria-label="All blog posts">
				<div class="border-b border-line">
					{posts.map((post, index) => (
						<article class="border-t border-line">
							<a href={`/blog/${post.id}/`} class="group grid gap-4 py-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-punch sm:grid-cols-[2.5rem_8rem_minmax(0,1fr)_auto] sm:items-start">
								<span class="hidden font-mono text-[0.62rem] text-muted sm:block">{String(index + 1).padStart(2, '0')}</span>
								<time datetime={post.data.pubDate.toISOString()} class="font-mono text-[0.68rem] text-muted">{formatDate.format(post.data.pubDate)}</time>
								<div>
									<h2 class="text-xl font-semibold tracking-[-0.03em] transition-colors group-hover:text-punch sm:text-2xl">{post.data.title}</h2>
									<p class="mt-2 max-w-2xl text-sm leading-6 text-muted">{post.data.description}</p>
									<ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
										{post.data.tags.map((tag) => <li class="border border-line px-2 py-1 font-mono text-[0.6rem] uppercase tracking-[0.08em] text-muted">{tag}</li>)}
									</ul>
								</div>
								<span class="font-mono text-[0.68rem] text-muted transition-transform duration-200 group-hover:translate-x-1">{post.data.readingTime} →</span>
							</a>
						</article>
					))}
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</BaseLayout>
