---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { profile } from '../../data/portfolio';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = 'Writing — ' + profile.name;
const description = 'Notes on software engineering, systems, Linux, and learning by ' + profile.name + '.';
const formatDate = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' });
---
<BaseLayout {title} {description}>
  <Header />
  <main id="main-content" class="page-width inner-main">
    <header class="page-intro" data-glyph="文">
      <p class="eyebrow">文章 / WRITING</p>
      <h1>Notes from the <span class="heading-accent">workbench.</span></h1>
      <p class="page-lead">Things I learned while building, breaking, and figuring things out.</p>
    </header>
    <div class="writing-list">
      {posts.map((post) => (
        <article>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate.format(post.data.pubDate)}</time>
          <div>
            <h2><a href={'/blog/' + post.id + '/'}>{post.data.title} <span aria-hidden="true">↗</span></a></h2>
            <p>{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
