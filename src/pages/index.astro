---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TechStack from '../components/TechStack.astro';
import { profile, projects, socials } from '../data/portfolio';

const title = `${profile.name} | Software Engineer`;
const description = `${profile.name} builds dependable systems and thoughtful digital products. Explore selected software engineering projects and writing.`;
---

<BaseLayout {title} {description}>
	<div id="top" class="relative">
		<Header />

		<main id="main-content">
			<section class="site-shell" aria-labelledby="hero-heading">
				<div class="grid lg:grid-cols-[minmax(0,1fr)_19rem]">
					<div class="px-5 py-12 sm:px-8 sm:py-14 lg:py-16">
						<div class="flex flex-wrap items-center justify-between gap-4 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted">
							<span>Software engineer · {profile.location} / IST</span>
							<span>Vol. 01 / 前進</span>
						</div>

						<div class="mt-10">
							<a href={profile.minimalPortfolio} target="_blank" rel="noreferrer" class="group mb-5 inline-flex items-center gap-2 border-b border-line pb-1 font-mono text-[0.68rem] font-medium uppercase tracking-[0.12em] text-muted transition-colors hover:border-ink hover:text-ink">
								Short on time? Take the portfolio speedrun
								<span class="text-punch transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
							</a>
							<h1 id="hero-heading" class="max-w-3xl text-balance text-[clamp(1.75rem,3.2vw,2.75rem)] font-medium leading-[1.2] tracking-[-0.04em] text-ink">
								{profile.intro}
							</h1>
						</div>

						<div class="mt-9">
							<div class="mb-3 flex items-center justify-between gap-4 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted">
								<span>Working set / 道具</span>
								<span class="hidden sm:block">Tools change. Fundamentals travel.</span>
							</div>
							<TechStack />
						</div>

						<div class="mt-10 flex flex-wrap items-center justify-between gap-5 border-t border-line pt-5">
							<p class="max-w-xl text-sm text-muted"><span class="font-medium text-ink">Stack-flexible by design.</span> I’m loyal to good constraints, not logos.</p>
							<a href="#work" class="group flex items-center gap-2 font-mono text-[0.68rem] font-medium uppercase tracking-[0.12em]">
								Selected work <span class="transition-transform duration-200 group-hover:translate-y-1">↓</span>
							</a>
						</div>
					</div>

					<aside class="border-t border-line bg-surface px-5 py-9 sm:px-8 lg:border-l lg:border-t-0 lg:px-6" aria-labelledby="learning-heading">
						<div class="flex items-center justify-between font-mono text-[0.62rem] uppercase tracking-[0.14em] text-punch">
							<span>Active learning</span>
							<span>修行中</span>
						</div>
						<h2 id="learning-heading" class="mt-8 text-2xl font-semibold tracking-[-0.035em]">Linux & cybersecurity</h2>
						<p class="mt-3 text-sm leading-6 text-muted">Going deeper into Linux internals, networking, system hardening, and practical security, one lab at a time.</p>
						<div class="mt-8 border-l-2 border-punch pl-4 font-mono text-[0.68rem] leading-5 text-muted">
							<span class="text-punch">$</span> learn --hands-on<br />
							<span class="text-punch">↳</span> status: in progress
						</div>
					</aside>
				</div>
			</section>

			<section id="work" class="site-shell border-t px-5 py-14 sm:px-8 sm:py-16" aria-labelledby="work-heading">
				<div class="mb-4 flex items-end justify-between gap-6">
					<div>
						<p class="section-kicker">01 / Selected work / 作品</p>
						<h2 id="work-heading" class="section-heading">Projects</h2>
					</div>
					<span class="font-mono text-xs text-muted">{String(projects.length).padStart(2, '0')}</span>
				</div>

				<div class="border-b border-line">
					{projects.map((project) => <ProjectRow {project} />)}
				</div>

			</section>

			<section id="about" class="site-shell grid border-t lg:grid-cols-[0.9fr_1.1fr]" aria-labelledby="about-heading">
				<div class="border-b border-line px-5 py-14 sm:px-8 lg:border-b-0 lg:border-r lg:py-16">
					<p class="section-kicker">02 / About / 自己紹介</p>
					<h2 id="about-heading" class="section-heading max-w-lg leading-tight">Curious about systems, interfaces, and everything between.</h2>
					<div class="mt-8 grid gap-5 text-sm leading-6 text-muted sm:grid-cols-2">
						<p>I care about software that is clear, dependable, and respectful of people’s time.</p>
						<p>Outside code, I learn languages, play guitar and keyboard, occasionally collect another instrument, and watch anime.</p>
					</div>
					<p class="mt-8 font-mono text-xs text-muted">Hunter × Hunter · One Piece · Haikyuu!!</p>
				</div>

				<div id="connect" class="px-5 py-14 sm:px-8 lg:py-16">
					<div class="flex items-end justify-between gap-4">
						<div>
							<p class="section-kicker">03 / Connect</p>
							<h2 class="section-heading">Elsewhere</h2>
						</div>
						<span class="hidden font-mono text-xs text-muted sm:block">Say hello ↗</span>
					</div>

					<div class="mt-8 grid grid-cols-2 border-l border-t border-line sm:grid-cols-3">
						{socials.map((social) => (
							<a
								href={social.href}
								target={social.href.startsWith('http') ? '_blank' : undefined}
								rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
								class="group flex min-h-16 items-center justify-between gap-2 border-b border-r border-line px-4 text-sm font-medium transition-colors hover:bg-ink hover:text-canvas focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-punch"
							>
								{social.label}
								<span class="text-muted transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-canvas">↗</span>
							</a>
						))}
					</div>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</BaseLayout>
