---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SeaToriiSunset from '../components/SeaToriiSunset.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile, projects } from '../data/portfolio';
const title = profile.name + ' — Software engineer';
const description = profile.name + ' is a software engineer building dependable systems and thoughtful digital products.';
---
<BaseLayout {title} {description}>
  <Header />
  <main id="main-content" class="page-width home-main">
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">Software engineer</p>
      <h1 id="intro-title">Saral <span class="heading-accent">Gupta</span></h1>
      <p class="intro-lead">I build dependable systems and thoughtful digital products.</p>
      <p class="intro-copy">My work moves between backend infrastructure and useful, focused interfaces. I like clear ideas, good constraints, and software that respects people’s time.</p>
      <div class="intro-links" aria-label="Contact and profiles">
        <a href={'mailto:' + profile.email}>Email me <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/saral-gupta7" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/saralgupta7" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://x.com/srlgpt_a" target="_blank" rel="noreferrer">Twitter <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="content-section" aria-labelledby="work-title">
      <div class="section-topline"><h2 id="work-title">Selected <span class="heading-accent">work</span></h2><a href="/work/">All work <span aria-hidden="true">↗</span></a></div>
      <div class="project-list">{projects.map((project) => <ProjectRow {project} />)}</div>
    </section>
    <SeaToriiSunset />
  </main>
  <SiteFooter />
</BaseLayout>
