---
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { profile } from '../data/portfolio';

interface Props {
	title: string;
	description: string;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	structuredData?: Record<string, unknown>;
}

const {
	title,
	description,
	ogType = 'website',
	publishedTime,
	structuredData: pageStructuredData,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-image.png', Astro.site);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	url: Astro.site,
	jobTitle: 'Software Engineer',
	sameAs: ['https://github.com/saral-gupta7', 'https://www.linkedin.com/in/saralgupta7', 'https://x.com/srlgpt_a'],
};
const structuredDataGraph = pageStructuredData
	? [structuredData, pageStructuredData]
	: structuredData;
---

<!doctype html>
<html lang="en" class="scheme-dark" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#080809" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${profile.name}, software engineer and curious builder`} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<title>{title}</title>
		<ClientRouter fallback="swap" />
		<script is:inline>
			if (!window.__initialMotionBooted) {
				window.__initialMotionBooted = true;
				if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					document.documentElement.classList.add('motion-pending');
					window.setTimeout(() => document.documentElement.classList.remove('motion-pending'), 2000);
				}
			}
		</script>
		<script type="application/ld+json" set:html={JSON.stringify(structuredDataGraph)} />
	</head>
	<body class="min-h-screen overflow-x-hidden bg-canvas font-sans text-ink antialiased">
		<a href="#main-content" class="fixed left-4 top-4 z-50 -translate-y-24 border border-ink bg-surface px-4 py-2 text-sm font-bold text-ink transition-transform focus:translate-y-0">Skip to content</a>
		<slot />
		<Analytics />
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>
